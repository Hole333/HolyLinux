---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SOCIAL_LINKS } from '../consts';
const socials=[
	{key:'github',label:'GitHub',href:SOCIAL_LINKS.github},
	{key:'x',label:'X / Twitter',href:SOCIAL_LINKS.x},
	{key:'telegram',label:'Telegram',href:SOCIAL_LINKS.telegram},
	{key:'whatsapp',label:'WhatsApp',href:SOCIAL_LINKS.whatsapp},
	{key:'rss',label:'RSS',href:SOCIAL_LINKS.rss},
] as const;
---
<!doctype html><html lang="zh-CN"><head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION}/></head><body class="home-page"><Header/><main class="profile-main"><section class="profile" aria-labelledby="profile-name"><img src="/avatar.svg" width="150" height="150" alt="HolyLinux 终端图标"/><h1 id="profile-name">HolyLinux</h1><p>保持清醒，保持好奇，记录每一次有价值的折腾</p><nav class="socials" aria-label="社交链接">{socials.map(item=>item.href?<a href={item.href} aria-label={item.label} title={item.label} target={item.href.startsWith('http')?'_blank':undefined} rel={item.href.startsWith('http')?'noreferrer':undefined}><SocialIcon name={item.key}/></a>:<span class="disabled" aria-label={`${item.label} 尚未配置`} title={`${item.label}：在 src/consts.ts 中配置链接`}><SocialIcon name={item.key}/></span>)}</nav></section></main><Footer/></body></html>
<style>.profile-main{display:grid;place-items:center;min-height:calc(100vh - var(--header-height) - var(--footer-height));padding-block:2rem}.profile{text-align:center}.profile img{width:150px;height:150px;margin-bottom:1rem;border-radius:48px;box-shadow:var(--shadow-soft)}.profile h1{margin:.2rem 0 .35rem;font-size:2.15rem}.profile p{max-width:580px;margin:0 auto;color:var(--secondary);font-size:1rem}.socials{display:flex;justify-content:center;align-items:center;gap:1.05rem;margin-top:1.15rem}.socials a,.socials span{display:grid;place-items:center;width:30px;height:30px;color:var(--secondary);transition:color 150ms ease,transform 150ms ease}.socials :global(svg){width:22px;height:22px}.socials a:hover{color:var(--primary);transform:translateY(-2px)}.socials .disabled{cursor:not-allowed;opacity:.42}@media(max-width:640px){.profile img{width:120px;height:120px;border-radius:38px}.profile h1{font-size:1.85rem}.profile p{max-width:320px}}</style>
