---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---
<!doctype html>
<html lang="zh-CN">
<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
<body class="home-page">
	<Header />
	<main class="profile-main">
		<section class="profile" aria-labelledby="profile-name">
			<img src="/avatar.svg" width="150" height="150" alt="HolyLinux 终端图标" />
			<h1 id="profile-name">HolyLinux</h1>
			<p>保持清醒，保持好奇，记录每一次有价值的折腾</p>
			<nav class="socials" aria-label="社交链接">
				<a href="https://github.com/Hole333/HolyLinux" aria-label="GitHub" title="GitHub">GH</a>
				<a href="/blog" aria-label="文章" title="文章">文</a>
				<a href="/tags" aria-label="标签" title="标签">#</a>
				<a href="/rss.xml" aria-label="RSS" title="RSS">RSS</a>
			</nav>
		</section>
	</main>
	<Footer />
</body>
</html>
<style>
	.profile-main{display:grid;place-items:center;min-height:calc(100vh - var(--header-height) - var(--footer-height));padding-block:2rem}.profile{text-align:center}.profile img{width:150px;height:150px;margin-bottom:1rem;border-radius:48px;box-shadow:var(--shadow-soft)}.profile h1{margin:.2rem 0 .35rem;font-size:2.15rem}.profile p{max-width:580px;margin:0 auto;color:var(--secondary);font-size:1rem}.socials{display:flex;justify-content:center;align-items:center;gap:1.15rem;margin-top:1.15rem}.socials a{display:grid;place-items:center;min-width:30px;height:30px;color:var(--secondary);font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.78rem;font-weight:700;text-decoration:none;transition:color 150ms ease,transform 150ms ease}.socials a:hover{color:var(--primary);transform:translateY(-2px)}@media(max-width:640px){.profile img{width:120px;height:120px;border-radius:38px}.profile h1{font-size:1.85rem}.profile p{max-width:320px}}
</style>
