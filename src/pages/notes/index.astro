---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
	.sort((a, b) => (b.data.updated ?? b.data.created).valueOf() - (a.data.updated ?? a.data.created).valueOf());
const categories = new Map<string, typeof notes>();
for (const note of notes) {
	const category = note.id.split('/')[0] || 'misc';
	if (!categories.has(category)) categories.set(category, []);
	categories.get(category)!.push(note);
}
const labels: Record<string, string> = { linux: 'Linux', programming: '编程', devops: '运维', misc: '其他' };
const categoryLabel = (name: string) => labels[name] ?? name;
const notePath = (id: string) => id.split('/').slice(1, -1).join(' / ');
---
<!doctype html><html lang="zh-CN"><head><BaseHead title="学习笔记 | HaloMoon" description="按目录分类并由 GitHub 自动同步的 HaloMoon Markdown 学习笔记。" /></head><body><Header/><main class="notes-page"><header><p class="eyebrow">MARKDOWN KNOWLEDGE BASE</p><h1>学习笔记</h1><p>目录就是分类，文件路径就是网址。所有内容均从独立 GitHub 仓库自动同步。</p></header>{notes.length === 0 ? <p class="empty">暂时还没有公开笔记。</p> : <div class="category-grid">{Array.from(categories.entries()).map(([category, items]) => <section class="category"><div class="category-heading"><h2>{categoryLabel(category)}</h2><code>notes/{category}/</code><span>{items.length}</span></div><div class="note-list">{items.map(note => <article><a href={`/notes/${note.id}/`}><strong>{note.data.title}</strong><span>{note.data.description}</span><small>{notePath(note.id) || note.id.split('/').at(-1)} · {(note.data.updated ?? note.data.created).toLocaleDateString('zh-CN')}</small></a></article>)}</div></section>)}</div>}</main><Footer/></body></html>
<style>.notes-page{width:min(900px,calc(100% - 40px));padding-top:2.8rem}.notes-page>header{max-width:680px;margin-bottom:2.2rem}.eyebrow{margin:0 0 .35rem;color:var(--secondary);font-family:'JetBrains Mono',monospace;font-size:.72rem;letter-spacing:.12em}.notes-page h1{margin:0 0 .65rem}.notes-page>header>p:last-child{color:var(--secondary)}.category-grid{display:grid;gap:1.4rem}.category{overflow:hidden;border:1px solid var(--border-soft);border-radius:var(--radius);background:var(--entry)}.category-heading{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:.8rem;padding:1rem 1.2rem;border-bottom:1px solid var(--border-soft)}.category-heading h2{margin:0;font-size:1.25rem}.category-heading code{justify-self:start;color:var(--secondary);font-size:.72rem}.category-heading span{display:grid;place-items:center;min-width:1.7rem;height:1.7rem;border-radius:999px;background:var(--surface-muted);color:var(--secondary);font-size:.75rem}.note-list article+article{border-top:1px solid var(--border-soft)}.note-list a{display:grid;gap:.18rem;padding:1rem 1.2rem;text-decoration:none;transition:background-color 160ms ease}.note-list a:hover{background:var(--surface-muted)}.note-list strong{color:var(--primary)}.note-list span{color:var(--secondary);font-size:.9rem}.note-list small{color:var(--secondary);font-family:'JetBrains Mono',monospace;font-size:.7rem}.empty{padding:1.2rem;border:1px dashed var(--border);border-radius:var(--radius);color:var(--secondary)}@media(max-width:560px){.notes-page{width:calc(100% - 28px)}.category-heading{grid-template-columns:1fr auto}.category-heading code{grid-column:1/-1;grid-row:2}.note-list a{padding:1rem}}@media(prefers-reduced-motion:reduce){.note-list a{transition:none}}
</style>
