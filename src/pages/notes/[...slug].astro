---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
export async function getStaticPaths(){const notes=await getCollection('notes',({data})=>!data.draft);return notes.map(note=>({params:{slug:note.id},props:note}))}
type Props=CollectionEntry<'notes'>;
const note=Astro.props;
const{Content,headings}=await render(note);
const wordCount=(note.body??'').replace(/```[\s\S]*?```/g,'').replace(/[#*`>\[\]()_-]/g,'').replace(/\s/g,'').length;
const readingTime=Math.max(1,Math.ceil(wordCount/500));
---
<BlogPost title={note.data.title} description={note.data.description} pubDate={note.data.created} updatedDate={note.data.updated} tags={note.data.tags} headings={headings} readingTime={readingTime} wordCount={wordCount} slug={note.id} canonicalPath={`/notes/${note.id}/`}><Content/></BlogPost>
