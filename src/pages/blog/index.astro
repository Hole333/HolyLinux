---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
const posts=(await getCollection('blog')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const archive=new Map<number,Map<number,typeof posts>>();
for(const post of posts){const year=post.data.pubDate.getFullYear();const month=post.data.pubDate.getMonth()+1;if(!archive.has(year))archive.set(year,new Map());const months=archive.get(year)!;if(!months.has(month))months.set(month,[]);months.get(month)!.push(post)}
const countText=(body='')=>body.replace(/```[\s\S]*?```/g,'').replace(/[#*`>\[\]()_-]/g,'').replace(/\s/g,'').length;
const monthNames=['','一月','二月','三月','四月','五月','六月','七月','八月','九月','十月','十一月','十二月'];
---
<!doctype html><html lang="zh-CN"><head><BaseHead title="文章 | HaloMoon" description="HaloMoon 文章归档" /></head><body><Header/><main class="archive-page"><h1>文章</h1><div class="archive" aria-label="文章归档">{Array.from(archive.entries()).map(([year,months])=><section class="year-block"><h2>{year}<sup>{Array.from(months.values()).reduce((n,list)=>n+list.length,0)}</sup></h2>{Array.from(months.entries()).map(([month,list])=><div class="month-block"><h3>{monthNames[month]}<sup>{list.length}</sup></h3><div class="timeline">{list.map(post=>{const words=countText(post.body);const minutes=Math.max(1,Math.ceil(words/500));return <article><a href={`/blog/${post.id}/`}>{post.data.title}</a><p>{post.data.pubDate.toLocaleDateString('zh-CN',{year:'numeric',month:'long',day:'numeric'})} · {minutes} 分钟 · {words} 字</p></article>})}</div></div>)}</section>)}</div></main><Footer/></body></html>
<style>.archive-page{width:min(720px,calc(100% - 40px));padding-top:2.5rem}.archive-page>h1{margin:0 0 1.4rem;font-size:2.35rem}.year-block{margin-bottom:2.5rem}.year-block>h2{margin:0 0 1.2rem;font-size:2.1rem}.year-block sup,.month-block sup{margin-left:.45rem;color:var(--secondary);font-size:.65rem;font-weight:400;vertical-align:super}.month-block{display:grid;grid-template-columns:105px 1fr;gap:1rem;margin:1rem 0 1.8rem}.month-block>h3{margin:0;padding-top:.35rem;text-align:right;font-size:1.05rem}.timeline{position:relative;padding-left:30px;border-left:1px solid var(--tertiary)}article{position:relative;padding:.25rem 0 1.1rem;border-bottom:1px solid var(--border-soft)}article+article{padding-top:1rem}article:before{position:absolute;left:-36px;top:.65rem;width:9px;height:9px;border:2px solid var(--border);border-radius:50%;background:var(--theme);content:''}article a{font-size:1rem;font-weight:700;text-decoration:none}article a:hover{text-decoration:underline}article p{margin:.2rem 0 0;color:var(--secondary);font-size:.78rem;line-height:1.5}@media(max-width:560px){.month-block{grid-template-columns:1fr}.month-block>h3{text-align:left}.timeline{margin-left:5px}}
</style>

