---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---
<header>
  <nav>
    <a class="brand" href="/" aria-label="HolyLinux 首页"><span>H</span>{SITE_TITLE}</a>
    <div class="internal-links"><HeaderLink href="/">首页</HeaderLink><HeaderLink href="/blog">文章</HeaderLink><HeaderLink href="/about">关于</HeaderLink></div>
    <div class="actions"><a class="github" href="https://github.com/Hole333/HolyLinux" target="_blank" rel="noreferrer">GitHub</a><button class="theme-toggle" type="button" aria-label="切换深浅色" title="切换深浅色"><svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 15.2A8.7 8.7 0 0 1 8.8 3.5 9 9 0 1 0 20.5 15.2Z" fill="currentColor"/></svg><svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="currentColor"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button></div>
  </nav>
</header>
<script>
  const root = document.documentElement;
  document.querySelector<HTMLButtonElement>('.theme-toggle')?.addEventListener('click', () => { const next = root.dataset.theme === 'dark' ? 'light' : 'dark'; root.dataset.theme = next; localStorage.setItem('holylinux-theme', next); });
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  document.addEventListener('pointerdown', (event) => { if (event.button !== 0 || event.pointerType === 'touch') return; const ring = document.createElement('span'); ring.className = 'click-ring'; ring.style.left = `${event.clientX}px`; ring.style.top = `${event.clientY}px`; document.body.append(ring); ring.animate([{ transform: 'translate(-50%, -50%) scale(.72)', opacity: .75 }, { transform: `translate(-50%, -50%) scale(${reduce.matches ? 1 : 1.55})`, opacity: 0 }], { duration: reduce.matches ? 160 : 260, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' }).onfinish = () => ring.remove(); });
</script>
<style>
  header{position:sticky;top:0;z-index:20;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(18px)}nav{width:min(1080px,calc(100% - 32px));min-height:68px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:1.5rem}.brand{display:flex;align-items:center;gap:.7rem;color:var(--text);font-weight:700;text-decoration:none}.brand span{display:grid;place-items:center;width:34px;height:34px;border-radius:11px 11px 11px 3px;background:var(--accent);color:#071313}.internal-links,.actions{display:flex;align-items:center;gap:1rem}.internal-links a,.github{color:var(--muted);font-size:.9rem;text-decoration:none}.theme-toggle{display:grid;place-items:center;width:38px;height:38px;padding:0;border:1px solid var(--line);border-radius:50%;background:var(--surface);color:var(--text);cursor:pointer}.theme-toggle svg{width:18px;height:18px}.sun,html[data-theme='dark'] .moon{display:none}html[data-theme='dark'] .sun{display:block}@media(max-width:640px){.github{display:none}nav{gap:.7rem}.internal-links{gap:.35rem}.internal-links a{padding-inline:.4rem}}
</style>
