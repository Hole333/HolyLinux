---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
type Props=CollectionEntry<'blog'>['data']&{headings?:MarkdownHeading[];readingTime?:number;wordCount?:number;slug?:string};
const{title,description,pubDate,updatedDate,heroImage,tags=[],headings=[],readingTime=1,wordCount=0,slug=''}=Astro.props;
const toc=headings.filter(h=>h.depth===2||h.depth===3);
---
<html lang="zh-CN"><head><BaseHead title={`${title} | HaloMoon`} description={description}/></head><body><Header/><main class="article-main"><article><header class="post-header"><h1>{title}</h1><p><FormattedDate date={pubDate}/> · {readingTime} 分钟 · {wordCount} 字</p></header><div class="article-grid"><div class="article-body">{heroImage&&<div class="hero-image"><Image width={960} height={480} src={heroImage} alt=""/></div>}<div class="prose"><slot/></div><section class="copyright" aria-label="文章版权"><strong>{title}</strong><a href={new URL(`/blog/${slug}/`,Astro.site).href}>{new URL(`/blog/${slug}/`,Astro.site).href}</a><dl><div><dt>本文作者</dt><dd>HaloMoon</dd></div><div><dt>发布于</dt><dd><FormattedDate date={pubDate}/></dd></div><div><dt>许可协议</dt><dd>CC BY-NC-SA 4.0</dd></div></dl><p>转载或引用时请注明出处，不得用于商业用途，并以相同方式共享。</p></section>{tags.length>0&&<nav class="post-tags" aria-label="文章标签">{tags.map(tag=><a href={`/tags/#${encodeURIComponent(tag)}`}>#{tag}</a>)}</nav>}</div>{toc.length>0&&<aside class="toc" aria-label="文章目录"><strong>本文目录</strong><ol>{toc.map(item=><li class:list={[`depth-${item.depth}`]}><a href={`#${item.slug}`}>{item.text}</a></li>)}</ol></aside>}</div></article></main><Footer/></body></html>
<style>.article-main{width:min(1024px,calc(100% - 40px));padding-top:2.4rem}.post-header{max-width:720px;margin-bottom:1.4rem}.post-header h1{margin:0 0 .4rem;font-size:2.35rem}.post-header p{margin:0;color:var(--secondary);font-size:.82rem}.article-grid{display:grid;grid-template-columns:minmax(0,720px) 200px;gap:28px;align-items:start}.hero-image{margin-bottom:2rem}.hero-image img{display:block;width:100%;aspect-ratio:2/1;object-fit:cover;box-shadow:var(--shadow-soft)}.prose{color:var(--content)}.prose :global(h2),.prose :global(h3){scroll-margin-top:95px;margin-top:2.2rem}.prose :global(p){margin-bottom:1.35rem}.toc{position:sticky;top:105px;padding-left:20px;border-left:1px solid var(--tertiary);font-size:.8rem}.toc strong{color:var(--primary)}.toc ol{margin:.65rem 0 0;padding:0;list-style:none}.toc li{margin:.4rem 0}.toc .depth-3{padding-left:.75rem}.toc a{color:var(--secondary);text-decoration:none}.toc a:hover{color:var(--primary)}.copyright{margin-top:3rem;padding:1.15rem 1.25rem;border:1px solid var(--border-soft);border-radius:var(--radius);background:var(--entry);font-size:.82rem}.copyright>strong,.copyright>a{display:block}.copyright>a{overflow:hidden;margin:.2rem 0 .9rem;color:var(--secondary);text-overflow:ellipsis;white-space:nowrap}.copyright dl{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem;margin:0}.copyright dl div{min-width:0}.copyright dt{color:var(--secondary)}.copyright dd{margin:0;color:var(--primary)}.copyright p{margin:.8rem 0 0;color:var(--secondary)}.post-tags{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.2rem}.post-tags a{color:var(--secondary);font-size:.82rem;text-decoration:none}.post-tags a:hover{color:var(--primary)}@media(max-width:900px){.article-grid{grid-template-columns:1fr}.toc{display:none}.article-main{width:min(720px,calc(100% - 28px))}}@media(max-width:560px){.post-header h1{font-size:1.9rem}.copyright dl{grid-template-columns:1fr}}
</style>

